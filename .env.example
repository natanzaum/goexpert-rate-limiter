# HTTP port exposed by the application
PORT=8080

# Redis connection
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Maximum requests per second for each IP
RATE_LIMIT_IP=10

# How long an IP/token stays blocked
RATE_LIMIT_BLOCK_TIME=5m

# Header used to read the access token
API_KEY_HEADER=API_KEY

# Token limits as a JSON object. Each token overrides the IP limit.
RATE_LIMIT_TOKENS={"token-100":100,"token-50":50}